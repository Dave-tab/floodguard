{
  "name": "floodguard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FloodGuard AI API server: public community data, reports, admin review and scheduled risk assessments",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
