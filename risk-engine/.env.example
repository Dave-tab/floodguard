# Copy this file to .env and fill in values. Never commit .env.

# Vultr Serverless Inference key: Vultr console > Compute > Serverless Inference >
# floodguard-risk-engine > Overview > Inference API Access
VULTR_INFERENCE_API_KEY=

# Optional: model to use (default deepseek-v4.1-flash-1017). Other options include glm-5.3, qwen3.8-27b.
VULTR_INFERENCE_MODEL=

# Optional: only needed for a commercial Open-Meteo plan
OPEN_METEO_API_KEY=

# Optional: reasoning effort sent to the model (default none). GLM models need "low".
VULTR_REASONING_EFFORT=
